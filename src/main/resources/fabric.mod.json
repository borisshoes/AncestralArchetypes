  "name": "Ancestral Archetypes",
  "description": "An Origins-inspired server-sided fabric mod",
  "authors": [
    "BorisShoes"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/ancestral-archetypes",
    "sources": "https://github.com/borisshoes/AncestralArchetypes",
